	column EsCompra
		dataType: int64
		formatString: 0
		lineageTag: a0e994b4-9329-4589-9452-54a4738b3161
		summarizeBy: sum
		sourceColumn: EsCompra

		annotation SummarizationSetBy = Automatic

	column SegmentoHoras
		dataType: string
		lineageTag: 21645945-f1cd-4ea7-ab2f-8ea4e9a0bcdc
		summarizeBy: none
		sourceColumn: SegmentoHoras

		annotation SummarizationSetBy = Automatic

	partition steam = m
		mode: import
		source =
				let
				    Ruta = "C:\Users\Hp\Downloads\steam-200k.csv",
				    Origen = Csv.Document(File.Contents(Ruta),
				        [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Renombrar = Table.RenameColumns(Encabezados,
				        {{"151603712","user_id"},{"The Elder Scrolls V Skyrim","game_name"},
				         {"purchase","behavior"},{"1.0","value"},{"0","col_extra"}}),
				    QuitarExtra = Table.RemoveColumns(Renombrar,{"col_extra"}),
				    Tipos = Table.TransformColumnTypes(QuitarExtra,
				        {{"user_id", Int64.Type},{"game_name", type text},
				         {"behavior", type text},{"value", type number}}),
				    LimpiarTexto = Table.TransformColumns(Tipos,
				        {{"game_name", Text.Trim}, {"behavior", Text.Proper}}),
				    SinNulos = Table.SelectRows(LimpiarTexto,
				        each [user_id] <> null and [game_name] <> null and [behavior] <> null),
				    Horas = Table.AddColumn(SinNulos, "HorasJugadas",
				        each if [behavior] = "Play" then [value] else null, type number),
				    EsCompra = Table.AddColumn(Horas, "EsCompra",
				        each if [behavior] = "Purchase" then 1 else 0, Int64.Type),
				    Segmento = Table.AddColumn(EsCompra, "SegmentoHoras",
				        each if [HorasJugadas] = null then "No aplica"
				             else if [HorasJugadas] < 1 then "Menos de 1 h"
				             else if [HorasJugadas] < 10 then "1 a 10 h"
				             else if [HorasJugadas] < 50 then "10 a 50 h"
				             else if [HorasJugadas] < 100 then "50 a 100 h"
				             else "Más de 100 h", type text)
				in
				    Segmento

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

