table steam
	lineageTag: f8900adc-45cb-4c20-b771-e335f582ac14

	measure 'Unidades Vendidas' = CALCULATE(COUNTROWS(steam), steam[behavior] = "Purchase")
		formatString: 0
		lineageTag: 41132ce2-3cb3-410f-b7af-51fa8f22f3e5

	measure 'Usuarios Únicos' = DISTINCTCOUNT(steam[user_id])
		formatString: 0
		lineageTag: ac5876aa-e13b-4094-b939-c3ce5558c9d8

	measure 'Catálogo de Juegos' = DISTINCTCOUNT(steam[game_name])
		formatString: 0
		lineageTag: 7eec8eb5-1f2a-4b46-a550-98390f0870e2

	measure 'Horas Totales' = CALCULATE(SUM(steam[value]), steam[behavior] = "Play")
		lineageTag: 126167e7-4d70-4e98-bb7b-bd64181baa50

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Juegos por Usuario' = DIVIDE([Unidades Vendidas], [Usuarios Únicos])
		lineageTag: a3667f36-c1cc-40cd-9cfc-f8fbcfcfb014

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Horas Prom. por Usuario' = DIVIDE([Horas Totales], [Usuarios Únicos])
		lineageTag: b7bb378f-96d3-4ec6-af71-ec64bb7b332b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tasa de Engagement' = DIVIDE(CALCULATE(DISTINCTCOUNT(steam[user_id]), steam[behavior] = "Play"), [Usuarios Únicos])
		lineageTag: 221e1f59-bb3e-49ed-a184-83e94e901b0e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Índice de Popularidad' = RANKX(ALL(steam[game_name]), [Unidades Vendidas], , DESC)
		formatString: 0
		lineageTag: 476bd078-fcfc-4ab9-9ae7-b20efbcda8f6

	measure '% Top 20 Juegos' = DIVIDE(CALCULATE([Unidades Vendidas], TOPN(20, VALUES(steam[game_name]), [Unidades Vendidas])), [Unidades Vendidas])
		lineageTag: 0dd9c569-ebf5-4bd0-8ee8-ad7f1f984686

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Promedio Horas' = CALCULATE(AVERAGE(steam[value]), steam[behavior] = "Play")
		lineageTag: 8929aa75-e9b4-4a30-9320-a8430a7d68cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mediana Horas' = CALCULATE(MEDIAN(steam[value]), steam[behavior] = "Play")
		lineageTag: cc54600a-2782-4d2b-b1c2-d69e014d0d49

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Máximo Horas' = CALCULATE(MAX(steam[value]), steam[behavior] = "Play")
		lineageTag: 2daddcbc-c45a-464c-808d-0e9b99064b07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Desviación Est.' = CALCULATE(STDEV.P(steam[value]), steam[behavior] = "Play")
		lineageTag: 1eeb2a81-91f8-4886-9dab-10720d5eb566

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Jugadores por Juego' = CALCULATE(DISTINCTCOUNT(steam[user_id]), steam[behavior] = "Play")
		formatString: 0
		lineageTag: 9e7858fd-efa8-4476-8640-c33229090ac2

	measure '% Casuales' = DIVIDE(CALCULATE([Usuarios Únicos], steam[SegmentoHoras] = "Menos de 1 h"), [Usuarios Únicos])
		lineageTag: 1cff69e3-4526-4608-a8e8-cf3da3062230

		annotation PBI_FormatHint = {"isGeneralNumber":true}

